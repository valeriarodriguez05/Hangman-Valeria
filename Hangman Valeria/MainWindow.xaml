<Window x:Class="Hangman_Valeria.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Hangman_Valeria"
        mc:Ignorable="d"
        Title="MainWindow" Background="White" Height="450" Width="800">
    <Window.Resources>
        <!-- Style général pour les boutons de lettres -->
        <Style x:Key="BtnLetterStyle" TargetType="Button">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="FontWeight" Value="Thin"/>
            <Setter Property="FontFamily" Value="Caladea"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="LightSkyBlue"/>

        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <!--  Image de fond -->
        <Grid.Background>
            <ImageBrush 
            ImageSource="assets/background/fond.jpg" 
            Stretch="UniformToFill"
            AlignmentX="Center"
            AlignmentY="Center"/>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="8*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <!-- *************************** Zone Titre **********************************************-->
        <Grid Grid.Row="0">
            <Label x:Name="lblWord" Content="HangMan" FontFamily="Gabriola" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- *************************** Zone Game **********************************************-->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.5*"/>
                <ColumnDefinition Width="3.5*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- *************************** Zone Pendues **********************************************-->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="8*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="1">
                    <Image x:Name="ImagePendu" Source="assets\pendu\pendu1.png" VerticalAlignment="Top" HorizontalAlignment="Center"></Image>
                </Grid>
                    <TextBlock x:Name="TB_Display" Grid.Row="0" FontFamily="Caladea" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                <Image x:Name="Img_Hangman" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
            </Grid>
            <!-- *************************** Zone Lettres **********************************************-->
            <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Name="Grd_Keypad">
                <Button Content="A" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="B" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="C" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="D" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="E" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="F" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="G" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="H" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="I" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="J" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="K" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="L" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="M" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="N" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="O" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="P" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="Q" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="R" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="S" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="T" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="U" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="V" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="W" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="X" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="Y" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
                <Button Content="Z" Click="Letter_Click" Style="{StaticResource BtnLetterStyle}"/>
            </WrapPanel>

            <!-- *************************** Zone Vies **********************************************-->
            <Grid Grid.Column="2">
                <TextBlock x:Name="TB_vie" Grid.Row="0" FontSize="28" FontFamily="Gabriola" HorizontalAlignment="Center" VerticalAlignment="Top" />
                <TextBlock x:Name="TB_time" Grid.Row="0" FontSize="28" FontFamily="Gabriola" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                <Grid Grid.Row="1">
                    <Image x:Name="ImageCoeurs" Source="assets\vies\coeurs.jpg"></Image>
                </Grid>

            </Grid>
        </Grid>

        <!-- *************************** Zone Prénom **********************************************-->
        <Grid Grid.Row="2">
            <Label x:Name="Lb_Footer" Content="Valeria" FontFamily="Gabriola" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Border BorderBrush="white" BorderThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5"/>
        </Grid>
    </Grid>
</Window>